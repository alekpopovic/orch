[Unit]
Description=orch node agent
Documentation=file:/usr/share/doc/orch/PRODUCTION_DEPLOYMENT.md
After=network-online.target docker.service
Wants=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=orch-agent
Group=orch-agent
SupplementaryGroups=docker
EnvironmentFile=/etc/orch/orch-agent.env
ExecStart=/usr/local/bin/orch-agent
Restart=always
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/run/docker.sock /var/lib/orch-agent /var/log/orch
StateDirectory=orch-agent
LogsDirectory=orch
SyslogIdentifier=orch-agent

[Install]
WantedBy=multi-user.target
