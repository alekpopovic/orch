[Unit]
Description=orch control-plane server
Documentation=file:/usr/share/doc/orch/PRODUCTION_DEPLOYMENT.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=orch
Group=orch
EnvironmentFile=/etc/orch/orch-server.env
ExecStart=/usr/local/bin/orch-server
Restart=always
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/orch /var/log/orch
StateDirectory=orch
LogsDirectory=orch
SyslogIdentifier=orch-server

[Install]
WantedBy=multi-user.target
