DATABASE_URL=postgres://orch:orch@localhost:5432/orch?sslmode=disable
ORCH_SERVER_ADDR=:8080
ORCH_SERVER_URL=http://localhost:8080
ORCH_TOKEN=
ORCH_AGENT_REGISTRATION_TOKEN=dev-registration-token
ORCH_JWT_SECRET=dev-user-jwt-secret
ORCH_SECRET_KEY=dev-secret-key-change-me
ORCH_USERS=admin:admin,operator:operator,viewer:viewer
ORCH_NODE_NAME=local-node
ORCH_AGENT_ADDR=:8081
ORCH_ADVERTISE_ADDRESS=http://127.0.0.1:8081
ORCH_NODE_LABELS=role=worker
ORCH_DOCKER_SOCKET=/var/run/docker.sock
ORCH_LOG_LEVEL=info
ORCH_AGENT_HEARTBEAT_INTERVAL=5s
ORCH_SHUTDOWN_TIMEOUT=10s
ORCH_NODE_MONITOR_INTERVAL=5s
ORCH_NODE_HEARTBEAT_TIMEOUT=30s
